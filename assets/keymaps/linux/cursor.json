[
  // Cursor for MacOS. See: https://docs.cursor.com/kbd
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {

    },
  },
  {
    "context": "Editor && mode == full",
    "use_key_equivalents": true,
    "bindings": {

       // In cursor uses "Ask" mode
       // In cursor uses "Agent" mode

      "shift-alt-h": "call_hierarchy::ShowIncomingCalls",
    },
  },

  {
    "context": "Editor && editor_agent_diff",
    "use_key_equivalents": true,
    "bindings": {

    },
  },

  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {

    },
  },
  {
    "context": "CallHierarchyPicker > Picker > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "shift-alt-h": "call_hierarchy::ToggleDirection",
    },
  },
]
